model Service {
  id                 Int                  @id @default(autoincrement())
  name               Json
  description        Json
  image              String
  durationMinutes    Int                  @map("duration_minutes")
  price              Float
  commission         Float?
  priceAfterDiscount Float?               @map("price_after_discount")
  status             ServiceStatus        @default(PENDING)
  available          Boolean              @default(true)
  totalOrders        Int                  @default(0) @map("total_orders")
  totalAmountSold    Int                  @default(0) @map("total_amount_sold")
  rating             Float                @default(0)
  review             Int                  @default(0)
  bestRated          Boolean?             @default(false) @map("best_rated")
  mostSeller         Boolean?             @default(false) @map("most_seller")
  deletedAt          DateTime?            @map("deleted_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  storeId            Int                  @map("store_id")
  categoryId         Int                  @map("category_id")
  ArchivedOrderItems ArchivedOrderItem[]
  Banners            Banner[]
  BundleScopes       BundleScopeService[]
  Campaigns          Campaign[]
  Favorites          FavoriteService[]
  OrderItems         OrderItem[]
  Addons             ServiceAddon[]
  Sizes              ServiceSize[]
  Category           Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  Store              Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId], map: "services_store_id_fkey")
  @@index([categoryId], map: "services_category_id_fkey")
  @@map("services")
}

model FavoriteService {
  serviceId  Int     @map("service_id")
  customerId Int     @map("customer_id")
  Customer   User    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  Service    Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([serviceId, customerId])
  @@index([serviceId, customerId])
  @@index([customerId], map: "favorite_service_customer_id_fkey")
  @@map("favorite_service")
}

model ServiceSize {
  id                 Int                 @id @default(autoincrement())
  name               Json
  price              Float
  priceAfterDiscount Float?              @map("price_after_discount")
  isDefault          Boolean             @default(false) @map("is_default")
  serviceId          Int                 @map("service_id")
  deletedAt          DateTime?           @map("deleted_at")
  ArchivedOrderItems ArchivedOrderItem[]
  OrderItems         OrderItem[]
  Service            Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId], map: "service_sizes_service_id_fkey")
  @@map("service_sizes")
}

model ServiceAddon {
  id                     Int                      @id @default(autoincrement())
  name                   Json
  price                  Float
  priceAfterDiscount     Float?                   @map("price_after_discount")
  serviceId              Int                      @map("service_id")
  deletedAt              DateTime?                @map("deleted_at")
  ArchivedOrderItemAddon ArchivedOrderItemAddon[]
  OrderItemAddon         OrderItemAddon[]
  Service                Service                  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId], map: "service_addons_service_id_fkey")
  @@map("service_addons")
}

enum ServiceStatus {
  PENDING
  ACTIVE
  INACTIVE
  REJECTED
}
